{
  "name": "agentofduty",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "assets": "blender --background --python-exit-code 1 --python tools/blender/export_hero_meshes.py",
    "capture": "node tools/capture.mjs",
    "diff": "node tools/diff.mjs",
    "perf": "node tools/perf.mjs",
    "gate": "npm run test && npm run build && node tools/scenarios.mjs && node tools/practice.mjs && node tools/capture.mjs && node tools/perf.mjs",
    "test": "node --test tests/**/*.test.mjs",
    "play": "node tools/play.mjs",
    "scenarios": "node tools/scenarios.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.51.0",
    "pngjs": "^7.0.0",
    "vite": "^6.2.0"
  }
}
